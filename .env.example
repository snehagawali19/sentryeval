ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Optional: use local Ollama for air-gapped operation
OLLAMA_BASE_URL=http://localhost:11434

# Optional: custom judge model (default: gpt-4o-mini for cost)
SENTRYEVAL_JUDGE_MODEL=gpt-4o-mini
SENTRYEVAL_ATTACKER_MODEL=gpt-4o-mini

# Cache and output directories
SENTRYEVAL_RUNS_DIR=runs
SENTRYEVAL_CACHE_DIR=.cache/sentryeval
